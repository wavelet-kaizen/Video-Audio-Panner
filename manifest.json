{
  "manifest_version": 3,
  "name": "Video Audio Panner",
  "version": "1.3",
  "description": "動画の音声を左右に振り分ける。Holodexのmultiviewでは動画の増減・表示位置に合わせて自動調整。",
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Video Audio Panner"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://holodex.net/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
